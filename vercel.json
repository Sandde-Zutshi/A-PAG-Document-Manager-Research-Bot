{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Document Manager Research Bot",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  }
}
