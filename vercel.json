{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Document Manager Research Bot",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30
    }
  }
}
